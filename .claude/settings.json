  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(mktemp) || exit 2; git -C \"$CLAUDE_PROJECT_DIR\" show refs/remotes/origin/main:.claude/hooks/guard.py > \"$f\" 2>/dev/null || cp \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" \"$f\" || { rm -f \"$f\"; exit 2; }; python3 -I \"$f\"; rc=$?; rm -f \"$f\"; [ \"$rc\" -eq 0 ] || exit 2"
          }
        ]
      }
    ]
  }
